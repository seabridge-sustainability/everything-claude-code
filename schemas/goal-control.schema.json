{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ecc.goal-control.v1",
  "title": "ECC Outcome Control Schema",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "stage": {
      "type": "string",
      "enum": [
        "source_identified",
        "source_acquired",
        "calculation_implemented",
        "authentic_input_processed",
        "api_served",
        "ui_displayed",
        "export_verified",
        "independently_validated",
        "deployed_browser_accepted"
      ]
    },
    "resultClass": {
      "type": "string",
      "enum": [
        "source_native_indicator",
        "provisional_score",
        "independently_validated_score",
        "user_visible_result",
        "engineering_activity",
        "other"
      ]
    },
    "authenticity": {
      "type": "string",
      "enum": ["authentic", "fixture", "mock", "synthetic", "unknown"]
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "lane_id",
        "required_stage",
        "required_evidence_kinds",
        "required_repositories",
        "allowed_result_classes",
        "acceptance_predicate",
        "requires_authentic",
        "requires_user_visible",
        "subject_scope",
        "required"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "lane_id": { "$ref": "#/$defs/nonEmptyString" },
        "required_stage": { "$ref": "#/$defs/stage" },
        "required_evidence_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceKind" },
          "uniqueItems": true
        },
        "required_repositories": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "allowed_result_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resultClass" },
          "uniqueItems": true
        },
        "acceptance_predicate": { "$ref": "#/$defs/nonEmptyString" },
        "requires_authentic": { "type": "boolean" },
        "requires_user_visible": { "type": "boolean" },
        "subject_scope": { "$ref": "#/$defs/nullableString" },
        "required": { "type": "boolean" }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status", "blocker", "next_action"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "type": "string",
          "enum": ["active", "blocked", "complete", "deferred"]
        },
        "blocker": { "$ref": "#/$defs/nullableString" },
        "next_action": { "$ref": "#/$defs/nullableString" }
      }
    },
    "ownerCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recorded_at", "instruction", "replaces"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "recorded_at": { "$ref": "#/$defs/nonEmptyString" },
        "instruction": { "$ref": "#/$defs/nonEmptyString" },
        "priority": { "$ref": "#/$defs/nonEmptyString" },
        "checkpoint_proof_id": { "$ref": "#/$defs/nonEmptyString" },
        "next_action": { "$ref": "#/$defs/nonEmptyString" },
        "source_harness": { "$ref": "#/$defs/nonEmptyString" },
        "replaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "confidence",
        "basis",
        "critical_path",
        "likely_hours",
        "next_checkpoint_at",
        "checkpoint_started_at",
        "checkpoint_proof_id",
        "updated_at"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["not_set", "on_track", "at_risk", "off_track"]
        },
        "confidence": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "basis": { "$ref": "#/$defs/nullableString" },
        "critical_path": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "likely_hours": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "next_checkpoint_at": { "$ref": "#/$defs/nullableString" },
        "checkpoint_started_at": { "$ref": "#/$defs/nullableString" },
        "checkpoint_proof_id": { "$ref": "#/$defs/nullableString" },
        "updated_at": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "activeGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "goal_id",
        "mode",
        "objective",
        "current_priority",
        "non_goals",
        "user_visible_proofs",
        "lanes",
        "owner_corrections",
        "forecast",
        "status",
        "updated_at"
      ],
      "properties": {
        "schema": { "const": "ecc.active-goal.v1" },
        "goal_id": { "$ref": "#/$defs/nonEmptyString" },
        "mode": {
          "type": "string",
          "enum": ["lightweight", "standard", "controlled"]
        },
        "objective": { "$ref": "#/$defs/nonEmptyString" },
        "current_priority": { "$ref": "#/$defs/nonEmptyString" },
        "non_goals": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "user_visible_proofs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/proof" }
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lane" }
        },
        "owner_corrections": {
          "type": "array",
          "items": { "$ref": "#/$defs/ownerCorrection" }
        },
        "forecast": { "$ref": "#/$defs/forecast" },
        "status": {
          "type": "string",
          "enum": ["active", "off_track", "blocked", "complete"]
        },
        "updated_at": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidenceKind": {
      "type": "string",
      "enum": ["command", "test", "runtime", "api", "browser", "export", "source", "independent_validation", "deployment", "other"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "sha256"],
      "properties": {
        "kind": { "$ref": "#/$defs/evidenceKind" },
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "outcomeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receipt_id",
        "goal_id",
        "acceptance_id",
        "stage",
        "result_class",
        "authenticity",
        "user_visible",
        "subject_scope",
        "observed_at",
        "environment",
        "commit",
        "repository_fingerprints",
        "evidence",
        "limitations",
        "source_harness",
        "status",
        "outcome",
        "supersedes"
      ],
      "properties": {
        "schema": { "const": "ecc.outcome-receipt.v1" },
        "receipt_id": { "$ref": "#/$defs/nonEmptyString" },
        "goal_id": { "$ref": "#/$defs/nonEmptyString" },
        "acceptance_id": { "$ref": "#/$defs/nonEmptyString" },
        "stage": { "$ref": "#/$defs/stage" },
        "result_class": { "$ref": "#/$defs/resultClass" },
        "authenticity": { "$ref": "#/$defs/authenticity" },
        "user_visible": { "type": "boolean" },
        "subject_scope": { "$ref": "#/$defs/nullableString" },
        "observed_at": { "$ref": "#/$defs/nonEmptyString" },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{7,64}$"
        },
        "repository_fingerprints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repositoryFingerprint" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "limitations": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "source_harness": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "type": "string",
          "enum": ["accepted", "retracted"]
        },
        "outcome": {
          "type": "string",
          "enum": ["pass", "fail"]
        },
        "supersedes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "claimCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "status", "evidence"],
      "properties": {
        "claim": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "type": "string",
          "enum": ["verified_current", "verified_stale", "unverified", "contradicted"]
        },
        "evidence": { "$ref": "#/$defs/nullableString" }
      }
    },
    "repositoryState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "repo_root",
        "head",
        "branch",
        "worktree",
        "dirty_paths",
        "staged_diff_sha256",
        "unstaged_diff_sha256",
        "untracked_sha256",
        "lockfiles_sha256",
        "tree_fingerprint",
        "lockfiles"
      ],
      "properties": {
        "repo_id": { "$ref": "#/$defs/nonEmptyString" },
        "repo_root": { "$ref": "#/$defs/nonEmptyString" },
        "head": { "$ref": "#/$defs/nonEmptyString" },
        "branch": { "$ref": "#/$defs/nullableString" },
        "worktree": { "$ref": "#/$defs/nonEmptyString" },
        "dirty_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "origin": { "$ref": "#/$defs/nullableString" },
        "staged_diff_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "unstaged_diff_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "untracked_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "lockfiles_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "tree_fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "lockfiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/lockfileFingerprint" }
        }
      }
    },
    "lockfileFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "repositoryFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "repo_root", "head", "tree_fingerprint"],
      "properties": {
        "repo_id": { "$ref": "#/$defs/nonEmptyString" },
        "repo_root": { "$ref": "#/$defs/nonEmptyString" },
        "head": { "$ref": "#/$defs/nonEmptyString" },
        "tree_fingerprint": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "spendingState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_usd", "approved_ceiling_usd", "ci_runs", "verified_at"],
      "properties": {
        "observed_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "approved_ceiling_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "ci_runs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "verified_at": { "$ref": "#/$defs/nullableString" }
      }
    },
    "assignmentBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tool_calls", "max_retries", "max_ci_runs", "max_cost_usd"],
      "properties": {
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "max_ci_runs": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "assignmentUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_calls", "retries", "ci_runs", "cost_usd"],
      "properties": {
        "tool_calls": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "ci_runs": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "watchdogPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "goal_id", "window_hours", "max_activity_without_proof",
        "max_retries", "max_ci_runs", "max_cost_usd", "updated_at"
      ],
      "properties": {
        "schema": { "const": "ecc.watchdog-policy.v1" },
        "goal_id": { "$ref": "#/$defs/nonEmptyString" },
        "window_hours": { "type": "number", "exclusiveMinimum": 0 },
        "max_activity_without_proof": { "type": "integer", "minimum": 0 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "max_ci_runs": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "updated_at": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "activityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "event_id", "goal_id", "observed_at", "kind", "count", "cost_usd", "tactic_id", "source_harness"],
      "properties": {
        "schema": { "const": "ecc.activity-event.v1" },
        "event_id": { "$ref": "#/$defs/nonEmptyString" },
        "goal_id": { "$ref": "#/$defs/nonEmptyString" },
        "observed_at": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "type": "string", "enum": ["tool_call", "retry", "ci_run", "cost", "tactic_change"] },
        "count": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "tactic_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_harness": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "assignment_id", "goal_id", "description", "acceptance_ids",
        "owner_runtime", "owner_agent", "scope_paths", "issued_at",
        "lease_expires_at", "budget", "source_harness"
      ],
      "properties": {
        "schema": { "const": "ecc.assignment.v1" },
        "assignment_id": { "$ref": "#/$defs/nonEmptyString" },
        "goal_id": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "acceptance_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "owner_runtime": { "$ref": "#/$defs/nonEmptyString" },
        "owner_agent": { "$ref": "#/$defs/nonEmptyString" },
        "scope_paths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "issued_at": { "$ref": "#/$defs/nonEmptyString" },
        "lease_expires_at": { "$ref": "#/$defs/nonEmptyString" },
        "budget": { "$ref": "#/$defs/assignmentBudget" },
        "source_harness": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "integrationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "receipt_id", "goal_id", "assignment_id", "observed_at",
        "integrator", "repository_fingerprints", "evidence", "usage",
        "outcome", "limitations", "source_harness"
      ],
      "properties": {
        "schema": { "const": "ecc.integration-receipt.v1" },
        "receipt_id": { "$ref": "#/$defs/nonEmptyString" },
        "goal_id": { "$ref": "#/$defs/nonEmptyString" },
        "assignment_id": { "$ref": "#/$defs/nonEmptyString" },
        "observed_at": { "$ref": "#/$defs/nonEmptyString" },
        "integrator": { "$ref": "#/$defs/nonEmptyString" },
        "repository_fingerprints": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/repositoryFingerprint" }
        },
        "evidence": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "usage": { "$ref": "#/$defs/assignmentUsage" },
        "outcome": { "type": "string", "enum": ["pass", "fail"] },
        "limitations": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "source_harness": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "resumeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receipt_id",
        "goal_id",
        "observed_at",
        "repository_state",
        "repository_states",
        "inherited_claims",
        "last_user_visible_result",
        "next_action",
        "blocked_lanes",
        "independent_work_remaining",
        "spending",
        "source_harness"
      ],
      "properties": {
        "schema": { "const": "ecc.resume-receipt.v1" },
        "receipt_id": { "$ref": "#/$defs/nonEmptyString" },
        "goal_id": { "$ref": "#/$defs/nonEmptyString" },
        "observed_at": { "$ref": "#/$defs/nonEmptyString" },
        "repository_state": { "$ref": "#/$defs/repositoryState" },
        "repository_states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repositoryState" }
        },
        "inherited_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimCheck" }
        },
        "last_user_visible_result": { "$ref": "#/$defs/nullableString" },
        "next_action": { "$ref": "#/$defs/nonEmptyString" },
        "blocked_lanes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "independent_work_remaining": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "spending": { "$ref": "#/$defs/spendingState" },
        "source_harness": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
