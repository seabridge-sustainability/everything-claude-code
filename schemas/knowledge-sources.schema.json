{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seabridge.knowledge-sources.v2",
  "title": "SeaBridgeAI Knowledge Source Registry",
  "description": "Public routing and safety contract for SeaBridgeAI knowledge sources. Host-specific locations, observed state, and operational evidence stay in a private local inventory. Cross-entry rules are enforced by scripts/lib/knowledge-sources.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updatedAt", "trustStates", "sources"],
  "properties": {
    "schema": { "const": "seabridge.knowledge-sources.v2" },
    "updatedAt": { "$ref": "#/definitions/date" },
    "trustStates": {
      "description": "The common review states. Order is the promotion order.",
      "type": "array",
      "const": ["unreviewed", "verified", "governed", "superseded"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source" }
    }
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "pattern": "\\S"
    },
    "principal": {
      "description": "Who may read or write. operator = Alejandro; coding-agents = any supported coding agent; platform-services = backend code paths; tenant-users = authenticated product users within their tenant.",
      "enum": ["operator", "coding-agents", "platform-services", "platform-agents", "tenant-users", "ci", "graph-builders"]
    },
    "trustState": { "enum": ["unreviewed", "verified", "governed", "superseded"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "authority", "lifecycle", "informationTypes", "canonicalStore",
        "owner", "scope", "sensitivity", "tenantData", "trustStates", "retention",
        "readers", "writers", "agentAccess", "derivedFrom", "derivedProjections",
        "citation", "health"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "title": { "$ref": "#/definitions/text" },
        "authority": {
          "description": "canonical = the source of truth for its information types; projection = rebuildable from derivedFrom and never edited by hand; interface = a view or editor over other sources; cache = convenience copy that must never be the only home of a fact.",
          "enum": ["canonical", "projection", "interface", "cache"]
        },
        "lifecycle": { "enum": ["active", "planned", "deprecated"] },
        "informationTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/slug" }
        },
        "canonicalStore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "location"],
          "properties": {
            "kind": {
              "enum": [
                "git-docs", "git-repo", "ecc-memory-vault", "gbrain", "obsidian-vault", "markdown-folder",
                "mongodb", "graphify-files", "falkordb", "issue-tracker", "harness-memory", "mcp-memory"
              ]
            },
            "location": {
              "description": "Logical location (repo:path, mongodb:collection, falkordb:graph, ~/path). Never a connection string or credential.",
              "$ref": "#/definitions/text"
            },
            "collections": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
            }
          }
        },
        "owner": { "$ref": "#/definitions/text" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["levels"],
          "properties": {
            "levels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["workspace", "project", "team", "user", "tenant"] }
            },
            "isolationKey": {
              "description": "The field(s) every read must filter on before ranking. Required when levels include tenant.",
              "$ref": "#/definitions/text"
            },
            "notes": { "$ref": "#/definitions/text" }
          }
        },
        "sensitivity": { "enum": ["public", "internal", "confidential", "tenant-confidential"] },
        "tenantData": {
          "description": "forbidden = customer/tenant information must never be written here or projected here; required = the store holds tenant data and every read is tenant-filtered.",
          "enum": ["forbidden", "required"]
        },
        "trustStates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/trustState" }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "supersession"],
          "properties": {
            "policy": { "$ref": "#/definitions/text" },
            "supersession": { "$ref": "#/definitions/text" }
          }
        },
        "readers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/principal" }
        },
        "writers": {
          "description": "Empty only for a deprecated source that accepts no new writes.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/principal" }
        },
        "agentAccess": {
          "description": "What coding agents may do here.",
          "enum": ["none", "read-only", "read-write", "propose-only"]
        },
        "derivedFrom": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/slug" }
        },
        "derivedProjections": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/slug" }
        },
        "citation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "identifier", "version"],
          "properties": {
            "required": { "type": "boolean" },
            "identifier": { "$ref": "#/definitions/text" },
            "version": { "$ref": "#/definitions/text" }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "freshness"],
          "properties": {
            "mechanism": { "$ref": "#/definitions/text" },
            "freshness": { "$ref": "#/definitions/text" },
            "command": { "$ref": "#/definitions/text" }
          }
        }
      }
    }
  }
}
