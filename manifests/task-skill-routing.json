{
  "version": 1,
  "authority": "Current host and project policy, latest owner request and one active goal",
  "codingSources": ["mattpocock-skills", "addyosmani-agent-skills", "ecc-engineering", "cursor-pstack", "ponytail", "ecc-scroll-craft", "ecc-higgsfield"],
  "always": ["Karpathy assumptions, simplicity, surgical edits and observable success", "Resolve material ambiguity from source before asking", "Preserve protected behavior and concurrent work", "Verify claims with appropriate actual evidence"],
  "routes": [
    {"id":"ponytail-review","patterns":["\\bponytail\\b.*\\breview\\b"],"source":"ponytail","name":"ponytail-review","skill":"sea-ponytail"},
    {"id":"ponytail-audit","patterns":["\\bponytail\\b.*\\baudit\\b"],"source":"ponytail","name":"ponytail-audit","skill":"sea-ponytail"},
    {"id":"ponytail-debt","patterns":["\\bponytail\\b.*(?:\\bdebt\\b|shortcut.ledger)"],"source":"ponytail","name":"ponytail-debt","skill":"sea-ponytail"},
    {"id":"ponytail-gain","patterns":["\\bponytail\\b.*(?:\\bgain\\b|benchmark|savings)"],"source":"ponytail","name":"ponytail-gain","skill":"sea-ponytail"},
    {"id":"ponytail-help","patterns":["\\bponytail\\b.*\\bhelp\\b"],"source":"ponytail","name":"ponytail-help","skill":"sea-ponytail"},
    {"id":"ponytail","patterns":["\\bponytail\\b"],"source":"ponytail","name":"ponytail","skill":"sea-ponytail"},
    {"id":"planning","patterns":["\\barena\\b|multi.model.plan|competing.plans|plan.judge"],"source":"cursor-pstack","name":"arena","skill":"sea-multi-model-planning"},
    {"id":"pstack-review","patterns":["\\binterrogate\\b|pstack.*review"],"source":"cursor-pstack","name":"interrogate","skill":"sea-adversarial-review"},
    {"id":"discovery","patterns":["\\bgrill(?:[ -]me|[ -]with[ -]docs)?\\b|requirements.discovery|clarify.requirements|material.ambiguity|sea-requirements-discovery"],"source":"ecc-engineering","name":"sea-requirements-discovery","skill":"sea-requirements-discovery"},
    {"id":"quality","patterns":["quality.contract|define.constraints|constraint.driven|constraints\\.(?:md|mmd)|sea-quality-contract"],"source":"ecc-engineering","name":"sea-quality-contract","skill":"sea-quality-contract"},
    {"id":"adversarial","patterns":["doubt.driven|sea-adversarial-review|consequential.claim"],"source":"ecc-engineering","name":"sea-adversarial-review","skill":"sea-adversarial-review"},
    {"id":"maintain-verification","patterns":["maintain.verification|verification.maintenance|feature.map.drift"],"source":"cursor-pstack","name":"maintain-verification-skill","skill":"sea-verify-seabridge"},
    {"id":"create-verification","patterns":["create.verification|verification.skill|verify.seabridge|verification.first"],"source":"cursor-pstack","name":"create-verification-skill","skill":"sea-verify-seabridge"},
    {"id":"adversarial-alias","patterns":["adversarial.review"],"source":"cursor-pstack","name":"interrogate","skill":"sea-adversarial-review"},
    {"id":"scroll-craft","patterns":["scroll[ -]?craft"],"source":"ecc-scroll-craft","name":"scroll-craft-dashboard-review","skill":"sea-frontend-ux-reviewer"},
    {"id":"higgsfield-assets","patterns":["(?=.*higgsfield)(?=.*(?:asset|image|video|visual|brand|marketing))"],"source":"ecc-higgsfield","name":"higgsfield-frontend-assets","skill":"sea-frontend-ux-reviewer"},
    {"id":"finance-audit","patterns":["(?:audit|check|debug|formula).*(?:spreadsheet|xlsx|financial model)|(?:spreadsheet|xlsx|financial model).*(?:audit|check|debug|formula)"],"source":"financial-services","plugin":"fsi-financial-analysis","name":"audit-xls","skill":"sea-dev-suite"},
    {"id":"finance-statements","patterns":["3.statement"],"source":"financial-services","plugin":"fsi-financial-analysis","name":"3-statement-model","skill":"sea-dev-suite"},
    {"id":"finance-dcf","patterns":["\\bdcf\\b"],"source":"financial-services","plugin":"fsi-financial-analysis","name":"dcf-model","skill":"sea-dev-suite"},
    {"id":"finance-author","patterns":["spreadsheet|xlsx|balance sheet|cash.flow|financial model"],"source":"financial-services","plugin":"fsi-financial-analysis","name":"xlsx-author","skill":"sea-dev-suite"},
    {"id":"frontend-presentation","patterns":["(?=.*(?:frontend|\\bui\\b|dashboard))(?=.*(?:\\bui\\b|design|layout|typograph|spacing|empty.state|readability|visual.hierarchy|accessibility|responsive))"],"excludePatterns":["^(?:debug|diagnose|investigate|profile|review code|code review|security review|auth review)\\b"],"source":"addyosmani-agent-skills","name":"frontend-ui-engineering","skill":"sea-frontend-ux-reviewer"},
    {"id":"debug","patterns":["debug|diagnos|\\bbug\\b|regression|stack.trace|\\berror\\b|\\bfailure\\b"],"source":"mattpocock-skills","name":"diagnosing-bugs","skill":"sea-systematic-debugging"},
    {"id":"security","patterns":["security|hardening|tenant.isolation|auth.review"],"source":"addyosmani-agent-skills","name":"security-and-hardening","skill":"sea-security-reviewer"},
    {"id":"review","patterns":["code.review|review.code|review.*(?:diff|pull.request|commit)|pr.review"],"source":"addyosmani-agent-skills","name":"code-review-and-quality","skill":"sea-code-review-response"},
    {"id":"performance","patterns":["performance|latency|slow.(?:page|query|api)|profil"],"source":"addyosmani-agent-skills","name":"performance-optimization","skill":"sea-dev-suite"},
    {"id":"api","patterns":["\\bapi\\b|interface.contract|payload|endpoint.contract"],"source":"addyosmani-agent-skills","name":"api-and-interface-design","skill":"sea-backend-api-verification"},
    {"id":"frontend","patterns":["frontend|\\bui\\b|tailwind|component|accessibility"],"source":"addyosmani-agent-skills","name":"frontend-ui-engineering","skill":"sea-frontend-ux-reviewer"},
    {"id":"domain","patterns":["domain.model|ubiquitous|glossary"],"source":"mattpocock-skills","name":"domain-modeling","skill":"sea-requirements-discovery"},
    {"id":"architecture","patterns":["architecture|system.design|codebase.design"],"source":"mattpocock-skills","name":"codebase-design","skill":"sea-architecture-reviewer"},
    {"id":"research","patterns":["research|primary.sources"],"source":"mattpocock-skills","name":"research","skill":"sea-dev-suite"}
  ]
}
